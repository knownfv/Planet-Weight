<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Planet Weight Calculator</title>
<style>
  :root{
    --bg1:#06101d;
    --bg2:#0b1a33;
    --card:rgba(17,27,51,.82);
    --line:rgba(255,255,255,.12);
    --text:#eef6ff;
    --muted:#b9c7e6;
    --gold:#ffd76a;
    --shadow:0 18px 50px rgba(0,0,0,.35);
  }
  *{box-sizing:border-box}
  html,body{
    margin:0;
    min-height:100%;
    font-family:Inter,system-ui,Arial,sans-serif;
    color:var(--text);
    background:
      radial-gradient(circle at 50% 15%, rgba(120,180,255,.18), transparent 28%),
      radial-gradient(circle at 18% 22%, rgba(167,112,255,.12), transparent 20%),
      linear-gradient(180deg,var(--bg2),var(--bg1) 60%, #040814);
    overflow-x:hidden;
  }
  body{
    position:relative;
  }

  .bg{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:0;
    overflow:hidden;
  }
  .star{
    position:absolute;
    background:#fff;
    border-radius:50%;
    opacity:.75;
    box-shadow:0 0 10px rgba(255,255,255,.45);
  }
  .sun{
    position:absolute;
    left:50%;
    top:20vh;
    width:120px;
    height:120px;
    transform:translate(-50%,-50%);
    border-radius:50%;
    background:radial-gradient(circle at 35% 35%, #fff7c7 0%, #ffe07a 25%, #ffb93b 48%, #ff7b2e 74%, rgba(255,123,46,.12) 100%);
    box-shadow:
      0 0 25px rgba(255,211,106,.7),
      0 0 70px rgba(255,165,70,.45),
      0 0 140px rgba(255,110,30,.2);
  }
  .orbit{
    position:absolute;
    left:50%;
    top:20vh;
    transform:translate(-50%,-50%);
    border:1px dashed rgba(255,255,255,.09);
    border-radius:50%;
    opacity:.45;
  }
  .planet{
    position:absolute;
    left:50%;
    top:20vh;
    border-radius:50%;
    transform:translate(-50%,-50%);
    box-shadow:0 0 18px rgba(255,255,255,.08);
    will-change:transform,left,top;
  }
  .planet::after{
    content:"";
    position:absolute;
    inset:10% 18% auto auto;
    width:25%;
    height:25%;
    border-radius:50%;
    background:rgba(255,255,255,.22);
    filter:blur(1px);
  }

  .page{
    position:relative;
    z-index:1;
    width:min(1100px,100%);
    margin:0 auto;
    padding:28px 16px 60px;
  }
  .hero{
    position:relative;
    padding:28px 24px 22px;
    border:1px solid var(--line);
    border-radius:24px;
    background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
    box-shadow:var(--shadow);
    overflow:hidden;
    backdrop-filter: blur(8px);
  }
  .hero::before, .hero::after{
    content:"";
    position:absolute;
    inset:auto;
    border-radius:50%;
    pointer-events:none;
    filter:blur(12px);
  }
  .hero::before{
    width:220px;height:220px;left:-60px;top:-70px;
    background:radial-gradient(circle, rgba(125,211,255,.22), rgba(125,211,255,0) 65%);
  }
  .hero::after{
    width:280px;height:280px;right:-90px;top:-100px;
    background:radial-gradient(circle, rgba(255,215,106,.12), rgba(255,215,106,0) 65%);
  }
  h1{
    margin:0 0 8px;
    font-size:clamp(30px,4vw,48px);
    letter-spacing:-0.03em;
  }
  .sub{
    color:var(--muted);
    line-height:1.5;
    max-width:760px;
    margin:0 0 18px;
  }
  .inputRow{
    display:grid;
    grid-template-columns:1fr auto auto;
    gap:12px;
    align-items:end;
    max-width:680px;
  }
  .field label{
    display:block;
    margin:0 0 8px;
    color:#d8e6ff;
    font-size:14px;
    font-weight:700;
  }
  .field input, .field select{
    width:100%;
    border:none;
    outline:none;
    border-radius:16px;
    padding:16px 16px;
    background:rgba(10,16,31,.75);
    color:var(--text);
    border:1px solid rgba(255,255,255,.12);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.04);
    font-size:16px;
  }
  .field input::placeholder{color:#90a2c9}
  .btn{
    border:none;
    border-radius:16px;
    padding:16px 18px;
    background:linear-gradient(180deg,#8be2ff,#61bfff);
    color:#07111f;
    font-weight:900;
    font-size:16px;
    cursor:pointer;
    box-shadow:0 12px 30px rgba(97,191,255,.28);
  }
  .btn:hover{filter:brightness(1.04)}
  .stats{
    display:grid;
    grid-template-columns:repeat(4, minmax(0,1fr));
    gap:12px;
    margin-top:18px;
  }
  .card{
    background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.04));
    border:1px solid var(--line);
    border-radius:18px;
    padding:16px;
    box-shadow:var(--shadow);
    backdrop-filter: blur(8px);
  }
  .card .planetName{
    font-weight:900;
    font-size:18px;
    margin-bottom:6px;
  }
  .card .weight{
    font-size:26px;
    font-weight:900;
    color:var(--gold);
    letter-spacing:-0.03em;
    margin-bottom:5px;
  }
  .card .ratio{
    color:var(--muted);
    font-size:13px;
    line-height:1.4;
  }
  .tableWrap{
    margin-top:16px;
    overflow:auto;
    border-radius:18px;
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    background:rgba(255,255,255,.04);
    backdrop-filter: blur(8px);
  }
  table{
    width:100%;
    border-collapse:collapse;
    min-width:760px;
  }
  th, td{
    padding:14px 16px;
    text-align:left;
    border-bottom:1px solid rgba(255,255,255,.08);
  }
  th{
    background:rgba(255,255,255,.06);
    color:#dbe8ff;
    font-size:13px;
    letter-spacing:.04em;
    text-transform:uppercase;
  }
  td{
    color:var(--text);
    font-size:15px;
  }
  tr:last-child td{border-bottom:none}
  .footer{
    margin-top:14px;
    color:var(--muted);
    font-size:13px;
    line-height:1.5;
  }

  .section{
    margin-top:28px;
    padding:24px;
    border:1px solid var(--line);
    border-radius:22px;
    background:rgba(255,255,255,.05);
    box-shadow:var(--shadow);
    backdrop-filter: blur(8px);
  }
  .section h2{
    margin:0 0 10px;
    font-size:22px;
  }
  .section p{
    margin:0;
    color:var(--muted);
    line-height:1.65;
    max-width:800px;
  }

  .pillRow{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-top:14px;
  }
  .pill{
    padding:8px 12px;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.12);
    background:rgba(255,255,255,.05);
    color:#dfeaff;
    font-size:13px;
  }

  @media (max-width: 900px){
    .stats{grid-template-columns:repeat(2, minmax(0,1fr))}
    .inputRow{grid-template-columns:1fr}
  }
  @media (max-width: 560px){
    .stats{grid-template-columns:1fr}
  }
</style>
</head>
<body>
<div class="bg" id="bg">
  <div class="sun"></div>
  <div class="orbit" id="orbit1"></div>
  <div class="orbit" id="orbit2"></div>
  <div class="orbit" id="orbit3"></div>
  <div class="orbit" id="orbit4"></div>
  <div class="orbit" id="orbit5"></div>
  <div class="orbit" id="orbit6"></div>
  <div class="orbit" id="orbit7"></div>

  <div class="planet" id="p1"></div>
  <div class="planet" id="p2"></div>
  <div class="planet" id="p3"></div>
  <div class="planet" id="p4"></div>
  <div class="planet" id="p5"></div>
  <div class="planet" id="p6"></div>
  <div class="planet" id="p7"></div>
  <div class="planet" id="p8"></div>
</div>

<div class="page">
  <div class="hero">
    <h1>Planet Weight Calculator</h1>
    <p class="sub">
      Enter your Earth weight and see how much you would weigh on each planet.
      The solar system in the background is slow and decorative so it stays calm while you scroll.
    </p>

    <div class="inputRow">
      <div class="field">
        <label for="weight">Your weight on Earth</label>
        <input id="weight" type="number" min="0" step="0.1" placeholder="e.g. 150" />
      </div>
      <div class="field">
        <label for="unit">Unit</label>
        <select id="unit">
          <option value="lb">Pounds (lb)</option>
          <option value="kg">Kilograms (kg)</option>
        </select>
      </div>
      <button class="btn" onclick="calculate()">Calculate</button>
    </div>

    <div class="pillRow">
      <div class="pill">Mercury: 0.378× Earth</div>
      <div class="pill">Venus: 0.907× Earth</div>
      <div class="pill">Mars: 0.377× Earth</div>
      <div class="pill">Jupiter: 2.36× Earth</div>
      <div class="pill">Saturn: 0.916× Earth</div>
      <div class="pill">Uranus: 0.889× Earth</div>
      <div class="pill">Neptune: 1.12× Earth</div>
    </div>
  </div>

  <div class="stats" id="cards"></div>

  <div class="tableWrap">
    <table>
      <thead>
        <tr>
          <th>Planet</th>
          <th>Gravity Ratio</th>
          <th>Your Weight</th>
        </tr>
      </thead>
      <tbody id="tableBody">
        <tr><td colspan="3">Enter your weight and click Calculate.</td></tr>
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>About the numbers</h2>
    <p>
      These estimates are based on planet surface gravity relative to Earth. The values are useful for comparison and are usually presented as gravity multipliers or surface gravity ratios.
    </p>
  </div>


  <div class="footer">
    Note: these are estimated surface-weight conversions based on standard relative gravity values.
    Small differences can exist depending on the source and rounding.
  </div>
</div>

<script>
const planets = [
  { name: 'Mercury', ratio: 0.378, color: '#b4b4b4', size: 10, orbit: 110, speed: 0.0030 },
  { name: 'Venus',   ratio: 0.907, color: '#d8b07a', size: 14, orbit: 150, speed: 0.0024 },
  { name: 'Earth',   ratio: 1.000, color: '#5aa7ff', size: 15, orbit: 200, speed: 0.0019 },
  { name: 'Mars',    ratio: 0.377, color: '#d65c4a', size: 12, orbit: 245, speed: 0.0015 },
  { name: 'Jupiter', ratio: 2.360, color: '#d6b28a', size: 30, orbit: 315, speed: 0.0011 },
  { name: 'Saturn',  ratio: 0.916, color: '#e0c58a', size: 26, orbit: 390, speed: 0.0009, ring: true },
  { name: 'Uranus',  ratio: 0.889, color: '#8ddde3', size: 19, orbit: 465, speed: 0.0007 },
  { name: 'Neptune', ratio: 1.120, color: '#507dff', size: 18, orbit: 540, speed: 0.00055 }
];

const unitLabels = { lb: 'lb', kg: 'kg' };
const bg = document.getElementById('bg');

function fmt(n) { return Number(n).toFixed(1); }

function calculate() {
  const weight = parseFloat(document.getElementById('weight').value);
  const unit = document.getElementById('unit').value;
  const cards = document.getElementById('cards');
  const tableBody = document.getElementById('tableBody');

  if (isNaN(weight) || weight <= 0) {
    cards.innerHTML = '';
    tableBody.innerHTML = '<tr><td colspan="3">Please enter a valid weight greater than 0.</td></tr>';
    return;
  }

  cards.innerHTML = planets.map(p => {
    const w = weight * p.ratio;
    return `
      <div class="card">
        <div class="planetName">${p.name}</div>
        <div class="weight">${fmt(w)} ${unitLabels[unit]}</div>
        <div class="ratio">Gravity: ${p.ratio.toFixed(3)} × Earth</div>
      </div>
    `;
  }).join('');

  tableBody.innerHTML = planets.map(p => {
    const w = weight * p.ratio;
    return `
      <tr>
        <td>${p.name}</td>
        <td>${p.ratio.toFixed(3)} × Earth</td>
        <td>${fmt(w)} ${unitLabels[unit]}</td>
      </tr>
    `;
  }).join('');
}

document.getElementById('weight').addEventListener('keydown', e => {
  if (e.key === 'Enter') calculate();
});
document.getElementById('unit').addEventListener('change', calculate);

const planetEls = planets.map((p, i) => document.getElementById('p' + (i + 1)));
const orbitEls = Array.from({length: 7}, (_, i) => document.getElementById('orbit' + (i + 1)));

function setSolarLayout() {
  const rect = bg.getBoundingClientRect();
  orbitEls.forEach((o, i) => {
    const d = planets[Math.min(i + 1, planets.length - 1)].orbit * 2;
    o.style.width = d + 'px';
    o.style.height = d + 'px';
    o.style.marginLeft = -(d/2) + 'px';
    o.style.marginTop = -(d/2) + 'px';
  });

  planetEls.forEach((el, i) => {
    const p = planets[i];
    el.style.width = p.size * 2 + 'px';
    el.style.height = p.size * 2 + 'px';
    el.style.background = `radial-gradient(circle at 35% 35%, rgba(255,255,255,.35) 0%, ${p.color} 40%, rgba(0,0,0,.45) 100%)`;
    el.dataset.orbit = p.orbit;
    el.dataset.speed = p.speed;
    el.dataset.phase = (i * 0.72).toString();
  });
}

function animatePlanets(t) {
  const rect = bg.getBoundingClientRect();
  const cx = rect.width * 0.5;
  const cy = rect.height * 0.20;

  planetEls.forEach((el, i) => {
    const p = planets[i];
    const a = t * p.speed + parseFloat(el.dataset.phase);
    const x = cx + Math.cos(a) * p.orbit;
    const y = cy + Math.sin(a) * (p.orbit * 0.5);

    el.style.left = x + 'px';
    el.style.top = y + 'px';
    el.style.width = (p.size * 2) + 'px';
    el.style.height = (p.size * 2) + 'px';

    if (p.ring) {
      el.style.transform = `translate(-50%, -50%) rotate(-20deg)`;
    } else {
      el.style.transform = `translate(-50%, -50%)`;
    }
  });

  requestAnimationFrame(animatePlanets);
}

function makeStars() {
  const count = 120;
  for (let i = 0; i < count; i++) {
    const s = document.createElement('div');
    s.className = 'star';
    const size = Math.random() * 2.4 + 0.5;
    s.style.width = size + 'px';
    s.style.height = size + 'px';
    s.style.left = (Math.random() * 100) + '%';
    s.style.top = (Math.random() * 100) + '%';
    s.style.opacity = (Math.random() * 0.75 + 0.15).toFixed(2);
    bg.appendChild(s);
  }
}

makeStars();
setSolarLayout();
window.addEventListener('resize', setSolarLayout);
requestAnimationFrame(animatePlanets);
</script>
</body>
</html>
